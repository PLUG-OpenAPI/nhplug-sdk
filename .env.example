# ─────────────────────────────────────────────────────────────
# NH Open API 설정 — 이 파일 하나만 채우면 모든 코드에 적용됩니다.
#
# 두는 곳 (둘 중 하나. 위가 아래보다 우선)
#   1) 프로젝트 폴더의  .env          ← 프로젝트마다 다르게 쓰고 싶을 때
#   2) ~/.nhplug/.env                ← 한 번 만들면 모든 프로젝트에 공통 적용 (권장)
#      Windows 예: C:\Users\<사용자>\.nhplug\.env
#   (NHPLUG_ENV_FILE=경로 로 위치를 직접 지정할 수도 있습니다)
#
# ⚠️ 자격증명이 들어가므로 git 에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 자격증명 (필수)
NHPLUG_APP_KEY=여기에_APP_KEY
NHPLUG_APP_SECRET=여기에_APP_SECRET

# ── 브랜드·환경 (아래는 나무(Namuh) 운영 기준)
#    나무=nhplug.com / N2=n2plug.com — API·필드는 동일하고 도메인만 다릅니다.
#    N2 고객은 아래 세 줄을 모두 n2plug 로 바꾸세요.

# 호출 대상: 운영 api(기본) / 모의투자 moapi(교육·시뮬레이션)
NHPLUG_BASE_URL=https://api.nhplug.com:8443

# 접근토큰은 운영 전용(moapi 미제공) — 호출이 moapi 여도 토큰은 api 에서 발급
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# 종목마스터(.mst) 다운로드 기준 URL
NHPLUG_INSTRUMENTS_BASE=https://www.nhplug.com/instruments

# ── N2 고객 예시 (위 세 줄을 이렇게 교체)
#   NHPLUG_BASE_URL=https://api.n2plug.com:8443          # 모의투자는 moapi.n2plug.com:8443
#   NHPLUG_AUTH_URL=https://api.n2plug.com:8443          # 토큰은 항상 api (moapi 아님)
#   NHPLUG_INSTRUMENTS_BASE=https://www.n2plug.com/instruments

# ── 선택
# NHPLUG_DEFAULT_ACCOUNT=계좌번호        # 샘플에서 계좌 생략 시 사용
# NHPLUG_WS_URL=                        # 실시간 주소 직접 지정(보통 BASE_URL 에서 자동 유도)
# NHPLUG_TOKEN_CACHE=0                  # 토큰 파일캐시 끄기
# NHPLUG_TOKEN_CACHE_DIR=               # 토큰 캐시 위치 (기본 ~/.nhplug/)
# NHPLUG_INSTRUMENTS_CACHE_DIR=         # 마스터 캐시 위치 (기본 ~/.nhplug/instruments/)
# NHPLUG_SUCCESS_CODES=00000,00166,00221,13578
